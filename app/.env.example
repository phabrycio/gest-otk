# ============================================================
# VARIÁVEIS DE AMBIENTE • TK GESTÃO E TECNOLOGIA
# Configuração para Vercel + Supabase + Gemini AI
# ============================================================

# Banco de Dados Supabase (PostgreSQL na Nuvem)
# Obtenha em: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# Google Gemini AI (Apoio Técnico e Copiloto Operacional)
# Obtenha em: https://aistudio.google.com -> Get API Key
VITE_GEMINI_API_KEY=sua-chave-api-google-gemini
